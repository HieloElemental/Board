---
import IceMark from "./IceMark.astro";

const links = [
  ["Twitter / X", "https://x.com/HieloElemental"],
  ["Bluesky", "https://bsky.app/profile/hieloelemental.bsky.social"],
  ["FurAffinity", "https://www.furaffinity.net/user/hieloelemental/"],
  ["Instagram", "https://www.instagram.com/hieloelemental/"],
  ["Facebook", "https://www.facebook.com/hielo.elemental/"],
  ["Telegram", "https://t.me/HieloElemental"],
  ["DeviantArt", "https://www.deviantart.com/hieloelemental"],
] as const;
---

<footer class="border-t border-border bg-bg py-8 px-5 md:px-8">
  <div
    class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-6 text-center sm:text-left"
  >
    <div class="flex items-center gap-2.5">
      <IceMark size={17} />
      <div>
        <p class="font-display font-semibold text-fg text-sm">
          Hielo Elemental
        </p>
        <p class="font-mono text-fg-dim text-[10px] tracking-wide mt-0.5">
          © 2026 · <span data-i18n="copyright"
            >all artwork is personal property</span
          >
        </p>
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
      {
        links.map(([label, href]) => (
          <a
            href={href}
            class="font-mono text-fg-dim text-[11px] hover:text-accent transition-colors duration-150 tracking-wide"
          >
            {label}
          </a>
        ))
      }
    </div>

    <p
      class="font-mono text-fg-dim text-[10px] tracking-[0.16em] leading-relaxed hidden lg:block"
    >
      <span data-i18n="footerTagline1">DRAWN WITH COLD HANDS</span><br />
      <span data-i18n="footerTagline2">AND WARM INTENT</span>
    </p>
  </div>
</footer>
