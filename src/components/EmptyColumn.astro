---
import IceMark from "./IceMark.astro";

interface Props {
  label: string;
  statusKey?: string;
}

const { label, statusKey } = Astro.props;
---

<div
  class="border border-dashed border-border rounded-lg flex flex-col items-center justify-center gap-2.5 py-12"
>
  <IceMark size={18} />
  <p
    class="font-mono text-fg-dim text-[10px] tracking-[0.15em] text-center leading-relaxed opacity-60"
  >
    <span data-i18n="emptyPrefix">NOTHING IN</span><br />
    <span data-i18n={statusKey} class="uppercase">{label}</span><span> </span>
    <span data-i18n="emptySuffix">YET</span>
  </p>
</div>
