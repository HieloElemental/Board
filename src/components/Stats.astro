---
import type { Commission } from "../types";

interface Props {
  commissions: Commission[];
}

const { commissions } = Astro.props;

const active = commissions.filter((c) => c.status !== "completed").length;
const waiting = commissions.filter((c) => c.status === "waiting").length;
const completed = commissions.filter((c) => c.status === "completed").length;

const items = [
  {
    labelKey: "statActive",
    label: "Active",
    value: String(active),
    subKey: "statActiveSub",
    sub: "in pipeline",
  },
  {
    labelKey: "statInQueue",
    label: "In Queue",
    value: String(waiting),
    subKey: "statInQueueSub",
    sub: "not yet started",
  },
  {
    labelKey: "statCompleted",
    label: "Completed",
    value: String(completed),
    subKey: "statCompletedSub",
    sub: `of ${commissions.length} total`,
    totalCount: commissions.length,
  },
  {
    labelKey: "statEstWait",
    label: "Est. Wait",
    value: `~${(waiting / 1.6).toFixed(1)}w`,
    subKey: "statEstWaitSub",
    sub: "for new openings",
  },
];
---

<section class="max-w-7xl mx-auto px-5 md:px-8 pb-14">
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
    {
      items.map(({ labelKey, label, value, subKey, sub, totalCount }) => (
        <div class="bg-surface border border-border rounded-lg px-4 py-4 md:px-5 md:py-5">
          <p
            class="font-mono text-fg-dim text-[10px] tracking-[0.18em] uppercase mb-3"
            data-i18n={labelKey}
          >
            {label}
          </p>
          <p class="font-display font-bold text-fg text-[34px] leading-none mb-2">
            {value}
          </p>
          <p
            class="font-mono text-fg-dim text-[10px]"
            data-i18n={subKey}
            data-total={totalCount}
          >
            {sub}
          </p>
        </div>
      ))
    }
  </div>
</section>
