---
interface Props {
  size?: number;
}

const { size = 22 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
  class="text-accent shrink-0"
>
  <polygon
    points="12,2.5 20.59,7.25 20.59,16.75 12,21.5 3.41,16.75 3.41,7.25"
    stroke="currentColor"
    stroke-width="1.3"
    fill="none"></polygon>
  <line
    x1="12"
    y1="2.5"
    x2="12"
    y2="21.5"
    stroke="currentColor"
    stroke-width="0.5"
    opacity="0.38"></line>
  <line
    x1="3.41"
    y1="7.25"
    x2="20.59"
    y2="16.75"
    stroke="currentColor"
    stroke-width="0.5"
    opacity="0.38"></line>
  <line
    x1="20.59"
    y1="7.25"
    x2="3.41"
    y2="16.75"
    stroke="currentColor"
    stroke-width="0.5"
    opacity="0.38"></line>
  <circle cx="12" cy="12" r="1.6" fill="currentColor" opacity="0.4"></circle>
</svg>
