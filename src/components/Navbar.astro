---
import IceMark from "./IceMark.astro";

const navItems = ["Commissions", "Gallery", "About"] as const;
---

<div class="sticky top-0 z-50 border-b border-border bg-bg/92 backdrop-blur-md">
  <div
    class="max-w-7xl mx-auto px-5 md:px-8 h-14.5 flex items-center justify-between gap-8"
  >
    <a href="#" class="flex items-center gap-2.5 group shrink-0">
      <IceMark size={19} />
      <span
        class="font-display font-semibold text-fg text-[15px] tracking-tight group-hover:text-accent transition-colors duration-150"
      >
        Hielo Elemental
      </span>
    </a>

    <nav class="hidden sm:flex items-center gap-7">
      {
        navItems.map((item) => (
          <a
            href={item === "Commissions" ? "#commissions" : "#"}
            class="font-body text-[13px] text-fg-sub hover:text-fg transition-colors duration-150"
          >
            {item}
          </a>
        ))
      }
      <a
        href="#"
        class="font-mono text-[11px] text-accent border border-accent/30 hover:bg-accent/10 hover:border-accent/50 transition-all duration-150 px-3 py-1.5 rounded tracking-wider"
      >
        Commission Info
      </a>
    </nav>

    <button
      class="sm:hidden text-fg-sub hover:text-fg transition-colors"
      aria-label="Open navigation"
    >
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
        <path
          d="M2 5h14M2 9h14M2 13h14"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
</div>
