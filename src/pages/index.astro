---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Board from "../components/Board.astro";
import Footer from "../components/Footer.astro";
import type { Commission } from "../types";

const rawCommissions = await getCollection("commissions");
const COMMISSIONS: Commission[] = rawCommissions.map((entry) => ({
  ...entry.data,
  entryId: entry.id,
  body: entry.body,
}));
---

<Layout title="Hielo's Commission Board">
  <div class="min-h-full bg-bg font-body">
    <Header commissions={COMMISSIONS} />
    <main>
      <Board commissions={COMMISSIONS} />
    </main>
    <Footer />
  </div>
</Layout>
