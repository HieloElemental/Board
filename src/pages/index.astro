---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Board from "../components/Board.astro";
import Footer from "../components/Footer.astro";
import type { Commission } from "../types";

const rawCommissions = await getCollection("commissions");
const allCommissions: Commission[] = rawCommissions.map((entry) => ({
  ...entry.data,
  entryId: entry.id,
  body: entry.body,
}));

const TWO_MONTHS_MS = 60 * 24 * 60 * 60 * 1000;
const cutoffDate = Date.now() - TWO_MONTHS_MS;

const activeCommissions = allCommissions.filter(
  (c) => c.status !== "completed",
);

const recentCompleted = allCommissions
  .filter(
    (c) =>
      c.status === "completed" && new Date(c.updatedAt).getTime() >= cutoffDate,
  )
  .sort(
    (a, b) => new Date(b.updatedAt).getTime() - new Date(a.updatedAt).getTime(),
  )
  .slice(0, 30);

const COMMISSIONS: Commission[] = [...activeCommissions, ...recentCompleted];
---

<Layout title="Hielo's Commission Board">
  <div class="min-h-full bg-bg font-body">
    <Header commissions={COMMISSIONS} />
    <main>
      <Board commissions={COMMISSIONS} />
    </main>
    <Footer />
  </div>
</Layout>
